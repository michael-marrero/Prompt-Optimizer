# OpenRouter (conversational backends — GPT-5, Claude, Gemini, DeepSeek, Qwen).
OPENROUTER_API_KEY=

# Anthropic (Claude Code SDK + computer-use). Same key for both.
ANTHROPIC_API_KEY=

# Computer-use opt-in. STRICT AND-semantics with settings.computer_use_opt_in (D-12).
# Setting this to "1" alone does NOT enable computer-use — the in-app settings toggle
# must ALSO be on. Defaults to "0" (disabled) on a fresh clone.
COMPUTER_USE_OPT_IN=0

# Override the storage root. Defaults to ~/.prompt-optimizer/ (D-15 + CONTEXT specifics line 324).
# PROMPT_OPTIMIZER_HOME=

# Override CORS allowed origins (comma-separated). Defaults to http://localhost:3000 (OSS-05).
# PROMPT_OPTIMIZER_CORS_ORIGINS=http://localhost:3000
