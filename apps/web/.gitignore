# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# Un-ignore the public template — plan 04-01 requires it committed so devs
# have a known-good starting point for FASTAPI_URL (CONTEXT D-05).
!.env.example
# D-05 belt-and-suspenders: explicit .env.local line so the rule is greppable
# by CI / pre-commit hooks looking for the literal path (T-04-01 mitigation).
.env.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
